# HQ Assistant (optional). Any OpenAI-compatible /chat/completions endpoint works;
# built for a Hermes gateway (`hermes gateway` API server) exposed through ngrok.
AGENT_BASE_URL=https://your-tunnel.ngrok.app/v1
AGENT_API_KEY=change-me   # API_SERVER_KEY from ~/.hermes/.env
AGENT_MODEL=hermes-agent
AGENT_TIMEOUT_MS=120000
